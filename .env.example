# Backend environment template — copy to .env for local / Railway variables.
# Railway injects PORT automatically; do not hardcode it in production.

DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# Local Postgres (optional). On Railway set:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# postgres://… from Railway is auto-converted to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://tams_user:tams_password@localhost:5432/tams_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Auto-import indian_KML into Postgres when assets table is empty
IMPORT_KML_ON_STARTUP=true
IMPORT_INCLUDE_TOWERS=true
IMPORT_BATCH_SIZE=500

REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

AWS_REGION=us-east-1
AWS_S3_BUCKET=tams-imagery-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Must include the Render website origin (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tams-txmr.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,*,.up.railway.app,.onrender.com

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

ENABLE_ML_FEATURES=true
MODEL_CACHE_DIR=./models

DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
CDSE_NIGHT_COLLECTION=sentinel-2-night-time-acquisitions
CDSE_S3_BUCKET=eodata
CDSE_S3_NIGHT_PREFIX=Sentinel-2/MSI/S2MSI_NIGHT
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
ENABLE_CDSE_STAC=false
