# Backend environment template — copy to .env for local dev.
# PORT must match frontend BACKEND_URL port.

DEBUG=true
LOG_LEVEL=DEBUG
PORT=8000

# Leave DB unreachable to run Gujarat KML mock mode locally
DATABASE_URL=postgresql+asyncpg://tams_user:tams_password@localhost:5432/tams_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

AWS_REGION=us-east-1
AWS_S3_BUCKET=tams-imagery-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tams-uob1.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,*,.onrender.com

# Render/production: add your frontend URL to CORS_ORIGINS, e.g.
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:3000
# Leave DATABASE_URL unset/unreachable to serve Gujarat KML mock assets.

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

ENABLE_ML_FEATURES=true
MODEL_CACHE_DIR=./models

DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
CDSE_NIGHT_COLLECTION=sentinel-2-night-time-acquisitions
CDSE_S3_BUCKET=eodata
CDSE_S3_NIGHT_PREFIX=Sentinel-2/MSI/S2MSI_NIGHT
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
ENABLE_CDSE_STAC=false
