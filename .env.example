# Copy to .env and fill in your values

# App Configuration
DEBUG=true
LOG_LEVEL=DEBUG
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://tams_user:tams_password@localhost:5432/tams_db
DATABASE_ECHO=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=tams-imagery-dev
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8000,http://localhost:5173,https://tams-uob1.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,*

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ML
ENABLE_ML_FEATURES=true
MODEL_CACHE_DIR=./models

# Pagination
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

# Copernicus Data Space - Sentinel-2 Night Campaign
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
CDSE_NIGHT_COLLECTION=sentinel-2-night-time-acquisitions
CDSE_S3_BUCKET=eodata
CDSE_S3_NIGHT_PREFIX=Sentinel-2/MSI/S2MSI_NIGHT
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
ENABLE_CDSE_STAC=true
