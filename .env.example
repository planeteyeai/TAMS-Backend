# Backend environment template — copy to .env (never commit real .env)

DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# Railway Postgres:
#   On Railway backend service use Variable Reference: ${{Postgres.DATABASE_URL}}
#   Locally use DATABASE_PUBLIC_URL from the Postgres service (proxy host)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway
DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

IMPORT_KML_ON_STARTUP=true
IMPORT_INCLUDE_TOWERS=true
IMPORT_BATCH_SIZE=500

REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

AWS_REGION=us-east-1
AWS_S3_BUCKET=tams-imagery-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional extra origins. Localhost any port, LAN, Render, Vercel, Railway are always allowed.
CORS_ORIGINS=
ALLOWED_HOSTS=localhost,127.0.0.1,*,.up.railway.app,.onrender.com

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

ENABLE_ML_FEATURES=true
MODEL_CACHE_DIR=./models

DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
CDSE_NIGHT_COLLECTION=sentinel-2-night-time-acquisitions
CDSE_S3_BUCKET=eodata
CDSE_S3_NIGHT_PREFIX=Sentinel-2/MSI/S2MSI_NIGHT
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
ENABLE_CDSE_STAC=false

# Optional — Google Flood Forecasting API (backend only; leave empty to use fallback model)
GOOGLE_FLOOD_API_KEY=
GOOGLE_PROJECT_ID=

# Google Gemini — AI geotechnical Transmission-line report (cached by lat/lon)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.15
GEMINI_MAX_OUTPUT_TOKENS=8192
